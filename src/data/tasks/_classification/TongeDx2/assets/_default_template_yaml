dataset_path: data/tongedx2
dataset_kwargs:
  custom_download: !function _tongedx2_utils.download
  load_from_disk: true
  token: true
doc_to_visual: !function _tongedx2_utils.doc_to_visual
doc_to_text: !function _tongedx2_utils.doc_to_text
doc_to_target: !function _tongedx2_utils.doc_to_target
output_type: generate_until
test_split: test

metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: false
    ignore_punctuation: false

metadata:
  - version: 0.0

